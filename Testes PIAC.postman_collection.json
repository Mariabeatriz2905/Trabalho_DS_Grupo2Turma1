          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Deve devolver status 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"A resposta deve ser JSON\", function () {\r",
                  "    pm.response.to.be.json;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"A resposta deve conter o token e o perfil administrador\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.have.property(\"token\");\r",
                  "    pm.expect(jsonData).to.have.property(\"utilizador\");\r",
                  "    pm.expect(jsonData.utilizador).to.have.property(\"perfil\");\r",
                  "    pm.expect(jsonData.utilizador.perfil).to.eql(\"administrador\");\r",
                  "});"
